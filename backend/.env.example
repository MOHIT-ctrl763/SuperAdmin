PORT=5000
NODE_ENV=development

# Database Configuration (Dedicated Super Admin PostgreSQL Database)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=superadmin_db

# JWT & Security
JWT_SECRET=superadmin_jwt_secret_standalone_9283749283472
JWT_EXPIRES_IN=7d

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5174

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@example.com
SMTP_PASS=app_password
SMTP_FROM="OrderFlow OMS" <admin@example.com>

# CRM Backend API Integration
CRM_API_BASE_URL=https://api.nexflowcrm.com/api/v1
# For local CRM running via VS Code:
# CRM_API_BASE_URL=http://localhost:7000/api/v1
CRM_SERVICE_EMAIL=
CRM_SERVICE_PASSWORD=
CRM_SERVICE_TOKEN=
CRM_REQUEST_TIMEOUT_MS=8000
